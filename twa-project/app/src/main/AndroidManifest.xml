<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 인터넷이 실제로 되는지 확인하려고 읽는다(MainActivity.isOnline).
         코드 파일은 인터넷이 될 때만 인터넷에서 받고, 안 될 때만 앱 안의 사본을 꺼내 쓴다.
         위치·개인정보와 무관한 '연결 상태만 보는' 권한이라 사용자에게 묻지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- enableOnBackInvokedCallback: targetSdk 35+ 라 어차피 기본값이 true 지만,
         MainActivity 가 새 방식(OnBackInvokedCallback)을 직접 등록하므로 의도를 명시해 둔다.
         (이 값이 true 인데 콜백을 등록하지 않으면 시스템이 뒤로가기를 가로채
          게임 중에도 앱이 홈으로 밀려난다 — 2026-07-30 수정 전 증상) -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="ABC Frog"
        android:supportsRtl="true"
        android:theme="@style/Theme.LauncherActivity"
        android:usesCleartextTraffic="false">

        <activity
            android:name="com.ggomzipapa.abcfrog.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
